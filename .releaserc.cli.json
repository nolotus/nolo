{
  "branches": [
    {"name": "alpha", "prerelease": "alpha"},
    "main"
  ],
  "tagFormat": "cli-v${version}",
  "plugins": [
    ["./scripts/release/componentSemanticRelease.mjs", {"component": "cli"}],
    ["@semantic-release/changelog", {"changelogFile": "packages/cli/CHANGELOG.md"}],
    ["@semantic-release/exec", {
      "prepareCmd": "bun ./scripts/release/applyCliVersion.ts ${nextRelease.version}"
    }],
    ["@semantic-release/git", {
      "assets": ["packages/cli/package.json", "packages/app/constants/cliDownloads.ts", "packages/cli/CHANGELOG.md"],
      "message": "chore(release): cli-v${nextRelease.version}\n\nAssistant-Model: glm-5.2\nAssistant-Harness: nolo-agent-run"
    }]
  ]
}
