{
  "manifest_version": 3,
  "name": "Nolo Browser Connector",
  "description": "Connects Nolo Desktop local agents to the user's Chrome tabs.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nolo Browser Connector"
  }
}
